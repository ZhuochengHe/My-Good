{
  "id": "memory",
  "name": "memory",
  "version": "2.0.0",
  "description": "Long-term memory management for the agent",
  "tools": [
    {
      "name": "save_memory",
      "description": "Save a new memory entry to persistent storage",
      "dangerous": false,
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "The factual text to remember"
          },
          "kind": {
            "type": "string",
            "enum": ["procedural", "experiential", "semantic", "episodic"],
            "description": "Memory kind: procedural=how to treat user, experiential=how to do tasks, semantic=objective facts, episodic=time-bound events"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Keyword tags for search (2-5 tags recommended)"
          },
          "ttlDays": {
            "type": "number",
            "description": "Time-to-live in days (episodic only)"
          },
          "source": {
            "type": "string",
            "description": "Source of the memory: 'user', 'agent', or 'consolidation'"
          }
        },
        "required": ["content", "kind"]
      },
      "handler": "handlers.js"
    },
    {
      "name": "search_memory",
      "description": "Search memory entries by content, tags, or kind",
      "dangerous": false,
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Text to search for in memory content"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Tags to filter by (any match)"
          },
          "kind": {
            "type": "string",
            "enum": ["procedural", "experiential", "semantic", "episodic"],
            "description": "Filter by kind"
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of results to return"
          }
        },
        "required": []
      },
      "handler": "handlers.js"
    },
    {
      "name": "update_memory",
      "description": "Update an existing memory entry",
      "dangerous": false,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Memory entry UUID"
          },
          "content": {
            "type": "string",
            "description": "New content text"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "New tags (replaces existing)"
          },
          "ttlDays": {
            "type": "number",
            "description": "New TTL in days from now (episodic only)"
          }
        },
        "required": ["id"]
      },
      "handler": "handlers.js"
    },
    {
      "name": "delete_memory",
      "description": "Permanently delete a memory entry",
      "dangerous": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Memory entry UUID to delete"
          }
        },
        "required": ["id"]
      },
      "handler": "handlers.js"
    },
    {
      "name": "list_memories",
      "description": "List all memory entries, optionally filtered by kind",
      "dangerous": false,
      "parameters": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["procedural", "experiential", "semantic", "episodic"],
            "description": "Kind to list. Lists all kinds if omitted."
          }
        },
        "required": []
      },
      "handler": "handlers.js"
    }
  ]
}
