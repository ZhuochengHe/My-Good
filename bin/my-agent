#!/usr/bin/env node
/**
 * CLI wrapper script for my-agent.
 * Handles development vs production execution and provides helpful error messages.
 */

import { existsSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const rootDir = join(__dirname, '..');
const cliPath = join(rootDir, 'dist', 'cli', 'index.js');

// Check if built files exist
if (!existsSync(cliPath)) {
  console.error('Error: my-agent has not been built yet.');
  console.error('');
  console.error('Please run one of the following:');
  console.error('  npm run build       # Build the project');
  console.error('  npm run dev         # Build and watch for changes');
  console.error('');
  console.error('Then try your command again.');
  process.exit(1);
}

// Import and run the CLI
import(cliPath).catch((error) => {
  console.error('Fatal error:', error);
  process.exit(1);
});
